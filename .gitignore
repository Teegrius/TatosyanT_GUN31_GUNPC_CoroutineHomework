cat > .gitignore << 'EOF'
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]user[Ss]ettings/

# MemoryCaptures
/memories/

# Gradle cache
.gradle/

# Autogenerated VS/MD files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj

# Unity3D generated meta files
*.pidb.meta

# Builds
*.apk
*.aab
*.unitypackage

# Crashlytics
crashlytics-build.properties
EOF